{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "pure-whisky",
  "main": "_worker.js",
  "compatibility_date": "2024-09-23",
  "observability": {
    "enabled": true
  },
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  "kv_namespaces": [
    {
      "binding": "PURE_KV",
      "id": "54eeb5664c6341e280e43f71c3e04379"
    }
  ],
  "r2_buckets": [
    {
      "binding": "MEDIA_BUCKET",
      "bucket_name": "website-datein"
    }
  ]
}
